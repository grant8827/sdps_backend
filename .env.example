DATABASE_URL=postgres://user@localhost:5432/sdpmplus_dev
PGSSL=false
FRONTEND_URL=http://localhost:5173
# The website address used in email links (production: https://sdpmplus.com).
PUBLIC_APP_URL=http://localhost:5173

# Transactional email (Mailtrap Email Sending). Port 587 uses STARTTLS.
# Sends: account invites, "Forgot password?" links, password-changed and
# two-step-reset alerts, the new-school welcome, guardian approvals and
# new-message notifications. Without these settings nothing is emailed:
# admins see a copyable set-up link instead, and Forgot password can't work.
# SMTP_FROM must use a sender/domain verified in your Mailtrap account.
# Check it with: npm run email:test -- you@example.com
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASSWORD=442125422632e0ff59aced0cf07259c5
SMTP_FROM=SDPMPlus <no-reply@sdpmplus.com>
# Optional address for replies from parents or staff:
# SMTP_REPLY_TO=office@your-school.org

# Encrypts two-step verification secrets in the database. 64 hex characters;
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Never change it once set — enrolled users would have to set up again.
MFA_ENCRYPTION_KEY=

# Creates the "Demo School" accounts (admin@school.test etc., password "password").
# true ONLY for local development or a demo server. Leave unset in production:
# when it's off, any demo accounts already in the database are deactivated.
SEED_DEMO_DATA=true

# Two-step verification is required for admin-dashboard accounts. Set to false
# ONLY for local development, to sign in to demo admin accounts with a password.
# REQUIRE_ADMIN_MFA=false

# School-admin accounts that may sign in without two-step verification —
# only the app store review account. Comma-separated emails.
# MFA_EXEMPT_EMAILS=playreview@sdpmplus.com

# Registering a school needs a 6-digit code emailed to the new administrator.
# Set to false ONLY for local development, where no email can be sent.
# REQUIRE_EMAIL_CONFIRMATION=false

# Set to 1 when running behind a TLS-terminating proxy other than Railway.
# TRUST_PROXY=1

# The platform dashboard's "today" and 30-day charts use this time zone
# (IANA name). Defaults to US Eastern.
# PLATFORM_TIMEZONE=America/New_York

# Database connections per server process (default 10).
# DB_POOL_MAX=10

# File storage for student and staff photos and school logos (Amazon S3).
# The bucket must be PRIVATE (keep "Block all public access" on): the app
# hands out links that work for one hour. The access key needs only
# s3:PutObject, s3:GetObject and s3:DeleteObject on this bucket.
# Without AWS_S3_BUCKET, images are saved inside the database instead.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Online card payment for school subscriptions (Stripe). Use the TEST keys
# (sk_test_...) until checkout has been tried end to end, then the live ones.
# The webhook endpoint in Stripe is  <backend URL>/api/billing/stripe/webhook
# and its signing secret (whsec_...) goes in STRIPE_WEBHOOK_SECRET.
# Without STRIPE_SECRET_KEY, schools ask for plan changes instead of paying online.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
