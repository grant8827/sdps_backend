DATABASE_URL=postgres://user@localhost:5432/school_dropoff_dev
PGSSL=false
FRONTEND_URL=http://localhost:5173

# Encrypts two-step verification secrets in the database. 64 hex characters;
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Never change it once set — enrolled users would have to set up again.
MFA_ENCRYPTION_KEY=

# Creates the "Demo School" accounts (admin@school.test etc., password "password").
# true ONLY for local development or a demo server. Leave unset in production:
# when it's off, any demo accounts already in the database are deactivated.
SEED_DEMO_DATA=true

# Two-step verification is required for admin-dashboard accounts. Set to false
# ONLY for local development, to sign in to demo admin accounts with a password.
# REQUIRE_ADMIN_MFA=false

# Set to 1 when running behind a TLS-terminating proxy other than Railway.
# TRUST_PROXY=1
