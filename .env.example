DATABASE_URL=postgres://user@localhost:5432/school_dropoff_dev
PGSSL=false
FRONTEND_URL=http://localhost:5173
# The website address used in email links (production: https://sdpmplus.com).
PUBLIC_APP_URL=http://localhost:5173

# Transactional email (Mailtrap Email Sending). Port 587 uses STARTTLS.
# Sends: account invites, "Forgot password?" links, password-changed and
# two-step-reset alerts, the new-school welcome, guardian approvals and
# new-message notifications. Without these settings nothing is emailed:
# admins see a copyable set-up link instead, and Forgot password can't work.
# SMTP_FROM must use a sender/domain verified in your Mailtrap account.
# Check it with: npm run email:test -- you@example.com
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASSWORD=442125422632e0ff59aced0cf07259c5
SMTP_FROM=SDPMPlus <no-reply@sdpmplus.com>
# Optional address for replies from parents or staff:
# SMTP_REPLY_TO=office@your-school.org

# Encrypts two-step verification secrets in the database. 64 hex characters;
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Never change it once set — enrolled users would have to set up again.
MFA_ENCRYPTION_KEY=

# Creates the "Demo School" accounts (admin@school.test etc., password "password").
# true ONLY for local development or a demo server. Leave unset in production:
# when it's off, any demo accounts already in the database are deactivated.
SEED_DEMO_DATA=true

# Two-step verification is required for admin-dashboard accounts. Set to false
# ONLY for local development, to sign in to demo admin accounts with a password.
# REQUIRE_ADMIN_MFA=false

# Set to 1 when running behind a TLS-terminating proxy other than Railway.
# TRUST_PROXY=1
